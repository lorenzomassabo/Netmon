#define _POSIX_C_SOURCE 200809L

#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

struct TcpConnection {
  uint32_t local_ip_hex;
  uint32_t local_port;
  uint32_t rem_ip_hex;
  uint32_t rem_port;
  uint32_t state;
};

int main(int argc, char *argv[]) {
  FILE *fp = fopen("/proc/net/tcp", "r");
  if (fp == NULL) {
    perror("File not found !");
    return 1;
  }

  char *line = NULL;
  size_t len = 0;
  struct TcpConnection conn;

  // read the first line to jump it
  if (getline(&line, &len, fp) != -1) {
    while (getline(&line, &len, fp) != -1) {
      int parsed = sscanf(line, "%*d: %X:%X %X:%X %X", &conn.local_ip_hex,
                          &conn.local_port, &conn.rem_ip_hex, &conn.rem_port,
                          &conn.state);
      if (parsed == 5) {
        printf("Local Port: %u -> Remote Port: %u (State: 0x%X)\n",
               conn.local_port, conn.rem_port, conn.state);
      }
    }
  }
  free(line);
  fclose(fp);
  return EXIT_SUCCESS;
}
